# Backend only. Never prefix an API key with REACT_APP_.
ANTHROPIC_API_KEY=
# CLAUDE_API_KEY is also accepted if you prefer that name.
CLAUDE_MODEL=claude-sonnet-5-5

# For GitHub Pages: deploy the portable backend, then set its complete endpoint
# URL here and rebuild the frontend. Leave blank for local development.
REACT_APP_COPENHAGEN_API_URL=

# Optional backend configuration:
API_PORT=8787
# If changing API_PORT locally, also set REACT_APP_COPENHAGEN_API_URL to that
# server's full endpoint URL.
COPENHAGEN_ALLOWED_ORIGINS=https://www.hhamlin.com,https://hhamlin.com,http://localhost:3000,http://127.0.0.1:3000
